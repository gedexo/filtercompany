NwCybjJ.png"}}, {"model": "web.banner", "pk": 8, "fields": {"size": "mobile", "product": 6, "name": "mb", "image": "banner-images/ABS2GSnTZa2RB2buF3AIngFOiVAQUqqT_mYdjftf.webp"}}, {"model": "web.product", "pk": 6, "fields": {"name": "4 Stage UF Water Purifier", "slug": "4-stage-uf-water-purifier", "image": "products/Filter_Company_Brochure._Print_File_17.05.25_1-10.jpg", "size": null, "title": null, "description": "<p data-start=\"150\" data-end=\"466\">Experience pure, safe, and great-tasting water every day with our 4 Stage UF (Ultra Filtration) Water Purifier, designed to remove impurities while retaining essential minerals. Ideal for homes with municipal/corporation water supply, this purifier ensures crystal-clear drinking water without using electricity.</p>", "meta_title": null, "meta_description": "", "schema_description": "", "key_word": "", "canonical_URL": null}}, {"model": "web.product", "pk": 7, "fields": {"name": "Fighter UV + UF Water Purifier", "slug": "fighter-uv-uf-water-purifier", "image": "products/Filter_Company_Brochure._Print_File_17.05.25_1-03_1_1.jpg", "size": null, "title": null, "description": "<p>Introducing the Fighter UV + UF Water Purifier, engineered to deliver superior protection against harmful microorganisms and impurities. Designed for areas with municipal/tap water supply, this advanced purifier combines Ultra Filtration (UF) and Ultraviolet (UV) purification technologies to ensure every drop of water is clean, safe, and healthy.</p>", "meta_title": null, "meta_description": "", "schema_description": "", "key_word": "", "canonical_URL": null}}, {"model": "web.product", "pk": 8, "fields": {"name": "Fighter 1.0 – Advanced Water Purifier", "slug": "fighter-10-advanced-water-purifier", "image": "products/Filter_Company_Brochure._Print_File_17.05.25_1-03_1_1_iKPhut2.jpg", "size": null, "title": null, "description": "<p data-start=\"311\" data-end=\"660\">Experience ultimate purity and unmatched performance with <strong data-start=\"369\" data-end=\"384\">Fighter 1.0</strong>, a next-generation water purifier designed to provide clean, safe, and great-tasting drinking water for your home and office. Built with advanced multi-stage purification technology, Fighter 1.0 ensures complete protection from impurities, bacteria, chemicals, and bad taste.</p>", "meta_title": null, "meta_description": "", "schema_description": "", "key_word": "", "canonical_URL": null}}, {"model": "web.product", "pk": 9, "fields": {"name": "Fighter Commercial", "slug": "fighter-commercial", "image": "products/Filter_Company_Brochure._Print_File_17.05.25_1-09.jpg", "size": null, "title": null, "description": "<p>The Fighter Commercial Water Purifier is engineered to deliver high-capacity purification for businesses, institutions, and industrial operations. Built with powerful multi-stage filtration technology and long-life purification components, it ensures continuous supply of clean, safe, and great-tasting water&mdash;perfect for high-usage environments.</p>", "meta_title": null, "meta_description": "", "schema_description": "", "key_word": "", "canonical_URL": null}}, {"model": "web.testimonial", "pk": 10, "fields": {"name": "Arun K", "position": null, "image": "testimonial-images/testimonial-v1-4.jpg", "description": "The Filter Company provided outstanding service and a high-quality purifier that completely transformed our water quality. Installation was fast, and the performance is excellent. Highly reliable and worth every penny."}}, {"model": "web.testimonial", "pk": 11, "fields": {"name": "Shahana M", "position": null, "image": "testimonial-images/testimonial-v1-3_n9rfW8F.jpg", "description": "We installed their commercial purification system and the results have been exceptional. The water taste improved immediately, and maintenance support has been very professional. Highly recommended partner"}}, {"model": "web.testimonial", "pk": 12, "fields": {"name": "Deepa S", "position": null, "image": "testimonial-images/